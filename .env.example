SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory
SHOPIFY_REDIRECT_URI=https://dev.example.ro/shopify/callback
APP_URL=https://dev.example.ro
DATABASE_URL=mysql://user:password@localhost:3306/shopify_connector
PORT=3000
# 32-byte hex, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
ADMIN_USERNAME=
# bcrypt hash, cost factor 12 — generate with:
# node -e "require('bcrypt').hash(process.argv[1],12).then(console.log)" 'yourpassword'
ADMIN_PASSWORD_HASH=
# random 64-char string, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# long random string for programmatic admin access
ADMIN_API_KEY=
RATE_LIMIT_MAX=100
LOG_LEVEL=info
NODE_ENV=production
